{
  "name": "dsh-deepseek-web-free",
  "description": "Unofficial DeepSeek Web provider for DeepSeek Harness: use chat.deepseek.com as an LLM source AND embed the DeepSeek web page inside DSH (right sidebar tab or draggable whale floating window) with one-time sign-in. Select conversation text and right-click to copy it straight into the embedded DeepSeek composer. 非官方 DeepSeek 网页端插件：既能把网页端当模型用，也能在 DSH 内嵌网页面板直接对话（侧栏标签页 / 鲸鱼悬浮球），登录一次双向同步；选中会话文字右键即可把内容复制到 DeepSeek 网页输入框。仅供个人方便使用，可能存在账号风险，作者不承担责任。",
  "version": "1.0.40",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "llm-provider",
    "deepseek-web",
    "webview",
    "sidebar-panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-deepseek-web-free.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-deepseek-web-free",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-deepseek-web-free/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-deepseek-web-free": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./tui": {
      "types": "./lib/tui.d.ts",
      "default": "./lib/tui.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.map",
    "wasm",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/README.md",
    "locale/*.json",
    "icon.svg",
    "docs/assets/**",
    "screenshots.json"
  ],
  "dsh": {
    "capabilities": ["llm:adapter", "network:egress", "sessions:read"],
    "labels": ["third-party-model-provider"],
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "disclosure": {
    "cloud": true,
    "network": [
      "https://chat.deepseek.com"
    ],
    "offlineMode": false,
    "apiKeys": [
      {
        "env": "DEEPSEEK_WEB_TOKEN",
        "storage": "dsh-credentials"
      }
    ],
    "permissions": {
      "network": [
        "chat.deepseek.com"
      ],
      "filesystem": [
        "plugin-isolated-browser-profile"
      ],
      "env": [
        "DEEPSEEK_WEB_TOKEN"
      ]
    },
    "jurisdiction": [
      "PIPL(CN)"
    ],
    "retention": "session"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0 || >=4.0.5-alpha.1 <5.0.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0-0 || >=3.18.5-alpha.1 <4.0.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.10.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:plugin": "pnpm --filter ./packages/plugin pack --pack-destination packages/plugin"
  }
}

{
  "name": "dsh-deepseek-web-free",
  "description": "仅保留 DSH 内悬浮球与侧边栏打开官方 chat.deepseek.com 网页面板；1.0.44 起已移除 DSH 内直接对话功能。⚠️ 作者已实测账号被禁言，请勿再通过本插件复用网页登录态发起对话（1.0.44 起已移除）。使用后果由使用者自行承担，作者与本项目不承担任何责任。 Only the floating ball and sidebar that open the official chat.deepseek.com web panel remain; in-DSH chat was removed in 1.0.44. WARNING: a real account ban was observed; do not reuse the web session to start chats through this plugin (removed in 1.0.44). Use is at your own risk; the author and this project accept no responsibility.",
  "version": "1.0.45",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "deepseek-web",
    "webview",
    "sidebar-panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-deepseek-web-free.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-deepseek-web-free",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-deepseek-web-free/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-deepseek-web-free": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./tui": {
      "types": "./lib/tui.d.ts",
      "default": "./lib/tui.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.map",
    "wasm",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/README.md",
    "locale/*.json",
    "icon.svg",
    "docs/assets/**",
    "screenshots.json"
  ],
  "dsh": {
    "capabilities": [
      "network:egress"
    ],
    "labels": [
      "web-panel-only"
    ],
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "disclosure": {
    "cloud": true,
    "network": [
      "https://chat.deepseek.com"
    ],
    "offlineMode": false,
    "apiKeys": [
      {
        "env": "DEEPSEEK_WEB_TOKEN",
        "storage": "dsh-credentials"
      }
    ],
    "permissions": {
      "network": [
        "chat.deepseek.com"
      ],
      "filesystem": [
        "plugin-isolated-browser-profile"
      ],
      "env": [
        "DEEPSEEK_WEB_TOKEN"
      ]
    },
    "jurisdiction": [
      "PIPL(CN)"
    ],
    "retention": "session"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0 || >=4.0.5-alpha.1 <5.0.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0-0 || >=3.18.5-alpha.1 <4.0.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.10.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:plugin": "pnpm --filter ./packages/plugin pack --pack-destination packages/plugin"
  }
}
